/target
examples/*/target
examples/*/target-c
/examples/oot-boot/rs/recompiled
# Agent scratch: worktrees + per-user settings. settings.local.json is
# per-machine by design; .claude/worktrees holds live checkouts.
/.claude/
# Eye-gate captures: frame PNGs from a user's own ROM. FAST-LOOP.md calls
# these evidence-only/untracked -- this is what enforces it (no game content
# in git, per AGENTS.md).
/.eyegate/

# Compiled mupen debug/trace drivers (build artifacts, never committed)
tools/mupen-bfs/mupen_bfs
tools/mupen-trace/mupen_trace

# Python bytecode cache from scripts/*.py (importers, ares trace driver).
# A transient build artifact -- running any script leaves it and it shows
# up as spurious worktree dirt otherwise.
__pycache__/
*.pyc
