    ("revenge-block-overlay-1-shard-04", "overlay1-shard04"),
    ("revenge-block-overlay-1-shard-05", "overlay1-shard05"),
    ("revenge-block-resident-tail-shard-00", "shard09"),
    ("revenge-block-resident-tail-shard-01", "shard10"),
    ("revenge-block-resident-tail-shard-02", "shard11"),
    ("revenge-block-resident-tail-shard-03", "shard12"),
    ("revenge-block-resident-tail-shard-04", "shard13"),
