#!/usr/bin/env bash
# oot -- the mechanical boot-bringup loop in one command.
#
# The OoT-on-fn64 debug loop is the SAME every rung: run the fast boot, see
# where it stops, resolve the crash/loop to a function name, look at the frame.
# This bakes in the fast-loop env (--release + OOT_MAX_SWAPS) so nobody retypes
# the 3 env vars, and adds the two things done by hand every rung: resolve a
# C backtrace line -> function name, and summarize where boot stopped.
#
# Usage:
#   ./oot run [SWAPS]        release boot, capped at SWAPS (default 6); prints summary + PNG paths
#   ./oot trace [SWAPS]      run + dump the last executor events (what was running at the stop)
#   ./oot fn FILE:LINE ...   resolve recompiled-C locations to RECOMP_FUNC names
#   ./oot where              run + report the deepest frame / loud trap (the frontier)
#
# Env overrides: RECOMPILED_DIR / ROM default under $FN64_GAME_DIR (your ROM-derived
# workspace). recomp.h is vendored in-tree, so RECOMP_H_DIR is not defaulted.
# FN64_RECOMP=rs selects the crate at RECOMP_RS_DIR; `c` is the default. The rs
# manifest links the out-of-tree audio ucode by default; FN64_SKIP_AUDIO_UCODE=1
# remains an explicit render-iteration speed switch.
# FN64_RENDER=rt64 enables the feature-gated RT64 static backend build.
set -uo pipefail

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
FN64="${FN64:-$(cd "$SCRIPT_DIR/../.." && pwd)}"
# FN64_GAME_DIR: the workspace holding YOUR ROM-derived material (ROM,
# RecompiledFuncs, generated ucode). Named for what it holds, not for whose
# project it is. No default: a path baked in here works for exactly one machine
# and fails confusingly everywhere else. Set it, or set RECOMPILED_DIR/ROM
# directly.
if [ -z "${FN64_GAME_DIR:-}" ] && { [ -z "${RECOMPILED_DIR:-}" ] || [ -z "${ROM:-}" ]; }; then
  echo "oot: set FN64_GAME_DIR to your ROM-derived workspace (it holds games/OOTU/...)," >&2
  echo "     or set RECOMPILED_DIR and ROM directly. No game content ships in this repo." >&2
  exit 2
fi
export FN64_GAME_DIR
export PATH="$HOME/.cargo/bin:$PATH"
export RECOMPILED_DIR="${RECOMPILED_DIR:-$FN64_GAME_DIR/games/OOTU/RecompiledFuncs}"
# RECOMP_H_DIR intentionally NOT defaulted: recomp.h is vendored in-tree (H1).
# Set it only to build against a different N64Recomp fork.
export ROM="${ROM:-$FN64_GAME_DIR/games/OOTU/oot-ntsc-1.0.z64}"
export RUST_BACKTRACE="${RUST_BACKTRACE:-1}"
export FN64_RECOMP="${FN64_RECOMP:-c}"
export RECOMP_RS_DIR="${RECOMP_RS_DIR:-/tmp/fn64-recomp-rs-oot}"

BIN="$FN64/examples/oot-boot/target/release/oot-boot"

build() {
  local features=()
  if [[ "${FN64_RENDER:-reference}" == "rt64" ]]; then
    features+=(--features rt64)
  fi
  if [[ "$FN64_RECOMP" == "rs" ]]; then
    # The rs-only manifest reuses this harness's build.rs/main.rs and its
    # build-only audio adapter, so the generated ucode resolves fn64-audio from
    # this same worktree rather than colliding with another worktree's package.
    recompiled_link="$FN64/examples/oot-boot/rs/recompiled"
    if [[ ( -e "$recompiled_link" || -L "$recompiled_link" ) && ! -L "$recompiled_link" ]]; then
      echo "oot: $recompiled_link exists and is not a symlink; refusing to replace it" >&2
      exit 2
    fi
    ln -sfn "$RECOMP_RS_DIR" "$recompiled_link" || exit 1
    CARGO_TARGET_DIR="$FN64/examples/oot-boot/target" \
      cargo build --manifest-path "$FN64/examples/oot-boot/rs/Cargo.toml" \
        --release -q "${features[@]}" || exit 1
  elif [[ "$FN64_RECOMP" == "c" ]]; then
    ( cd "$FN64/examples/oot-boot" && cargo build --release -q "${features[@]}" ) || exit 1
  else
    echo "oot: FN64_RECOMP must be 'rs' or 'c', got '$FN64_RECOMP'" >&2
    exit 2
  fi
}

# Resolve one FILE:LINE in the recompiled C to its enclosing RECOMP_FUNC name.
resolve_fn() {
  local loc="$1" f ln name
  f="${loc%%:*}"; ln="${loc##*:}"
  name=$(head -n "$ln" "$RECOMPILED_DIR/$f" 2>/dev/null | grep "RECOMP_FUNC " | tail -1 \
         | sed -E 's/.*RECOMP_FUNC [a-z0-9_]+ ([A-Za-z0-9_]+).*/\1/')
  echo "$loc -> ${name:-<not found>}"
}

cmd="${1:-run}"; shift || true
case "$cmd" in
  fn)
    for loc in "$@"; do resolve_fn "$loc"; done
    ;;
  run)
    build
    swaps="${1:-6}"
    OOT_MAX_SWAPS="$swaps" "$BIN" 2>&1 | grep -iE "swap #|VI swaps observed|gfx tasks|NON-CLEAR|dumped|exceeds|get_function|vram 0x|stopping early|panicked|EXIT" | tail -15
    echo "PNGs: $(ls /tmp/fn64-oot-render-*.png 2>/dev/null | wc -l | tr -d ' ') in /tmp/fn64-oot-render-*.png"
    ;;
  where)
    build
    # Run, capture, then resolve any recompiled-C backtrace lines to fn names.
    out=$(OOT_MAX_SWAPS="${1:-200}" "$BIN" 2>&1 || true)
    echo "$out" | grep -iE "VI swaps observed|get_function|no loaded section|exceeds ROM|panicked at" | tail -5
    echo "--- frontier (C backtrace -> functions) ---"
    echo "$out" | grep -oE "funcs_[0-9]+\.c:[0-9]+" | while read -r loc; do resolve_fn "$loc"; done | tail -8
    ;;
  trace)
    build
    OOT_TRACE=1 OOT_MAX_SWAPS="${1:-200}" "$BIN" >/dev/null 2>&1 || true
    echo "last executor events (/tmp/oot-boot-trace.jsonl):"
    tail -6 /tmp/oot-boot-trace.jsonl 2>/dev/null
    ;;
  *)
    echo "usage: ./oot {run [SWAPS]|trace [SWAPS]|fn FILE:LINE...|where}" >&2; exit 2 ;;
esac
