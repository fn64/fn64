{
  "schema": "fn64.unsupported-event-sites.v2",
  "families": [
    {
      "operation_prefix": "render.",
      "subsystem": "render",
      "dispositions": ["loud_trap", "returned_error"],
      "recorder_path": "crates/fn64-render-reference/src/lib.rs",
      "recorder_trigger": "fn64_runtime::record_unsupported_event(",
      "source_paths": [
        "crates/fn64-render-reference/src/backend.rs",
        "crates/fn64-render-reference/src/gbi.rs",
        "crates/fn64-render-reference/src/raster.rs",
        "crates/fn64-render-reference/src/s2dex.rs"
      ]
    },
    {
      "operation_prefix": "abi.si.voice-command-",
      "subsystem": "abi",
      "dispositions": ["loud_trap"],
      "recorder_path": "crates/fn64-abi/src/si.rs",
      "recorder_trigger": "format!(\"abi.si.voice-command-{command:02x}\")",
      "source_paths": [
        "crates/fn64-abi/src/si.rs"
      ]
    },
    {
      "operation_prefix": "abi.si.pif-command-",
      "subsystem": "abi",
      "dispositions": ["loud_trap"],
      "recorder_path": "crates/fn64-abi/src/si.rs",
      "recorder_trigger": "format!(\"abi.si.pif-command-{command:02x}\")",
      "source_paths": [
        "crates/fn64-abi/src/si.rs"
      ]
    }
  ],
  "sites": [
    {
      "operation": "runtime.overlay.get-function",
      "subsystem": "runtime",
      "disposition": "loud_trap",
      "path": "crates/fn64-runtime/src/overlay.rs",
      "trigger": "get_function: no loaded section resolves vram"
    },
    {
      "operation": "runtime.transfer-pak.read-address",
      "subsystem": "runtime",
      "disposition": "loud_trap",
      "path": "crates/fn64-runtime/src/transfer_pak.rs",
      "trigger": "Transfer Pak read uses unsupported accessory address"
    },
    {
      "operation": "runtime.transfer-pak.power-value",
      "subsystem": "runtime",
      "disposition": "loud_trap",
      "path": "crates/fn64-runtime/src/transfer_pak.rs",
      "trigger": "Transfer Pak power/probe write at"
    },
    {
      "operation": "runtime.transfer-pak.write-address",
      "subsystem": "runtime",
      "disposition": "loud_trap",
      "path": "crates/fn64-runtime/src/transfer_pak.rs",
      "trigger": "Transfer Pak write uses unsupported accessory address"
    },
    {
      "operation": "runtime.transfer-pak.battery-metadata-version",
      "subsystem": "runtime",
      "disposition": "returned_error",
      "path": "crates/fn64-runtime/src/transfer_pak.rs",
      "trigger": "MBC3 battery metadata version {version} is unsupported"
    },
    {
      "operation": "runtime.transfer-pak.cartridge-type",
      "subsystem": "runtime",
      "disposition": "returned_error",
      "path": "crates/fn64-runtime/src/transfer_pak.rs",
      "trigger": "Game Boy cartridge type {other:#04x} is unsupported"
    },
    {
      "operation": "abi.generated-c-mmio.bad-width",
      "subsystem": "abi",
      "disposition": "loud_trap",
      "path": "crates/fn64-abi/src/lib.rs",
      "trigger": "used unsupported {width}-byte access"
    },
    {
      "operation": "abi.generated-c-memory.unaligned",
      "subsystem": "abi",
      "disposition": "loud_trap",
      "path": "crates/fn64-abi/src/lib.rs",
      "trigger": "generated-C {width}-byte {operation} at unaligned guest address"
    },
    {
      "operation": "abi.generated-c-direct-device.bad-address",
      "subsystem": "abi",
      "disposition": "loud_trap",
      "path": "crates/fn64-abi/src/lib.rs",
      "trigger": "used unsupported mapped address with width"
    },
    {
      "operation": "abi.pi.epi-handle",
      "subsystem": "abi",
      "disposition": "loud_trap",
      "path": "crates/fn64-abi/src/pi.rs",
      "trigger": "fn64_runtime::UnsupportedSubsystem::Abi,\n        \"abi.pi.epi-handle\""
    },
    {
      "operation": "audio.task.missing-execution-policy",
      "subsystem": "audio",
      "disposition": "loud_trap",
      "path": "crates/fn64-abi/src/task_dispatch.rs",
      "trigger": "task={:#010x} type={} ucode={:#010x}/size={:#x}"
    },
    {
      "operation": "audio.translated-ucode.exit-reason",
      "subsystem": "audio",
      "disposition": "loud_trap",
      "path": "crates/fn64-abi/src/task_dispatch.rs",
      "trigger": "task_offset={o:#010x} exit_reason={reason}"
    },
    {
      "operation": "audio.rsp.unknown-instruction",
      "subsystem": "audio",
      "disposition": "returned_error",
      "path": "crates/fn64-audio/src/rsp/recomp/mod.rs",
      "trigger": "unimplemented RSP instruction word"
    },
    {
      "operation": "audio.rsp.unimplemented-vu-op",
      "subsystem": "audio",
      "disposition": "returned_error",
      "path": "crates/fn64-audio/src/rsp/recomp/mod.rs",
      "trigger": "has no dispatch body"
    },
    {
      "operation": "audio.rsp.delay-slot-control-transfer",
      "subsystem": "audio",
      "disposition": "loud_trap",
      "path": "crates/fn64-audio/src/rsp/recomp/mod.rs",
      "trigger": "unsupported RSP control transfer"
    },
    {
      "operation": "audio.rsp.unhandled-jump-target",
      "subsystem": "audio",
      "disposition": "returned_error",
      "path": "crates/fn64-audio/src/rsp/recomp/mod.rs",
      "trigger": "has no admitted instruction"
    },
    {
      "operation": "audio.rsp.imem-overrun",
      "subsystem": "audio",
      "disposition": "returned_error",
      "path": "crates/fn64-audio/src/rsp/recomp/mod.rs",
      "trigger": "ran outside admitted IMEM"
    },
    {
      "operation": "audio.rsp.recompiler-step-budget",
      "subsystem": "audio",
      "disposition": "returned_error",
      "path": "crates/fn64-audio/src/rsp/recomp/mod.rs",
      "trigger": "exceeded its fixed step budget"
    },
    {
      "operation": "audio.ucode-executor.unimplemented",
      "subsystem": "audio",
      "disposition": "returned_error",
      "path": "crates/fn64-audio/src/lib.rs",
      "trigger": "instead of fabricating output"
    },
    {
      "operation": "recompiler.cpu.unsupported-instruction",
      "subsystem": "recompiler",
      "disposition": "loud_trap",
      "path": "crates/fn64-abi/src/recompiled.rs",
      "trigger": "recompiler.cpu.unsupported-instruction"
    },
    {
      "operation": "render.raw-rdp.default-backend",
      "subsystem": "render",
      "disposition": "returned_error",
      "path": "crates/fn64-render/src/lib.rs",
      "trigger": "raw RDP command execution ["
    },
    {
      "operation": "render.geometry-task-inspection.rejected",
      "subsystem": "render",
      "disposition": "returned_error",
      "path": "crates/fn64-render/src/geometry_task_inspection.rs",
      "trigger": "inspector={INSPECTOR}; reason={reason}"
    },
    {
      "operation": "render.backend.unsupported-ucode",
      "subsystem": "render",
      "disposition": "loud_trap",
      "path": "crates/fn64-abi/src/task_dispatch.rs",
      "trigger": "backend rejected unlisted microcode at RDRAM offset"
    },
    {
      "operation": "render.raw-dpc-batch.non-certifying",
      "subsystem": "render",
      "disposition": "loud_trap",
      "path": "crates/fn64-abi/src/task_dispatch.rs",
      "trigger": "the staged-RDRAM renderer seam is diagnostic-only"
    },
    {
      "operation": "recompiler.verified-audio.executable-write",
      "subsystem": "recompiler",
      "disposition": "loud_trap",
      "path": "crates/fn64-abi/src/task_dispatch.rs",
      "trigger": "verified audio publication rejected"
    },
    {
      "operation": "render.hle-ucode.needs-lle",
      "subsystem": "render",
      "disposition": "needs_lle",
      "path": "crates/fn64-abi/src/task_dispatch.rs",
      "trigger": "microcode_sha256={digest}"
    }
  ]
}
